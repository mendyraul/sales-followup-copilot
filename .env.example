# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_followup"

# App display name in the UI
NEXT_PUBLIC_APP_NAME="Sales Follow-Up Copilot"

# Safety default: keep manual mode to prevent live outbound sends
SEND_MODE="manual"

# AI backend selector (mock keeps local/offline-safe behavior)
AI_PROVIDER="mock"

# Only required when using a non-mock AI provider
AI_API_KEY=""