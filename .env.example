# PostgreSQL DSN for Prisma + app runtime
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_followup"
# Client-visible app title
NEXT_PUBLIC_APP_NAME="Sales Follow-Up Copilot"
# Keep manual to prevent live outbound sends in local/dev
SEND_MODE="manual"
# Use mock provider by default to avoid external AI calls
AI_PROVIDER="mock"
# Required only when AI_PROVIDER is a real external provider
AI_API_KEY=""
