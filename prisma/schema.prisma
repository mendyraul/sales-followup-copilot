generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  HOT
  WON
  LOST
}

model Lead {
  id            String      @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String?
  status        LeadStatus  @default(NEW)
  unsubscribed  Boolean     @default(false)
  optOutReason  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  drafts        FollowUpDraft[]
  events        LeadEvent[]
  feedback      FeedbackCapture[]
}

model FollowUpDraft {
  id          String   @id @default(cuid())
  leadId      String
  stage       String
  content     String
  approved    Boolean  @default(false)
  rejected    Boolean  @default(false)
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId     String
  eventType  String
  payload    String?
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  payload    String?
  createdAt  DateTime @default(now())
}

model FeedbackCapture {
  id           String   @id @default(cuid())
  leadId        String?
  source        String   @default("in-app")
  category      String   @default("general")
  message       String
  rating        Int?
  contactEmail  String?
  contextJson   String?
  createdAt     DateTime @default(now())

  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
}
