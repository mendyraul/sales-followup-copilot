generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  HOT
  WON
  LOST
}

model Lead {
  id            String      @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String?
  status        LeadStatus  @default(NEW)
  unsubscribed  Boolean     @default(false)
  optOutReason  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  drafts        FollowUpDraft[]
  events        LeadEvent[]
}

model FollowUpDraft {
  id          String   @id @default(cuid())
  leadId      String
  stage       String
  content     String
  approved    Boolean  @default(false)
  rejected    Boolean  @default(false)
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId     String
  eventType  String
  payload    String?
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entityType String
  entityId  String?
  payload   String?
  createdAt DateTime @default(now())
}


enum FeedbackSource {
  IN_APP
  EMAIL
  CALL
  MANUAL
}

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model FeedbackEntry {
  id          String            @id @default(cuid())
  leadId       String
  source       FeedbackSource    @default(IN_APP)
  sentiment    FeedbackSentiment @default(NEUTRAL)
  rating       Int?
  summary      String
  actionItems  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}
