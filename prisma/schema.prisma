generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  HOT
  WON
  LOST
}

model Lead {
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id            String      @id @default(cuid())
  name          String      @unique
  email         String?
  phone         String?
  source        String?
  status        LeadStatus  @default(NEW)
  hotLead       Boolean     @default(false)
  unsubscribed  Boolean     @default(false)
  optOutReason  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  drafts        FollowUpDraft[]
  events        LeadEvent[]
  timelineNotes LeadNote[]
  feedbackEntries FeedbackEntry[]
}

model FollowUpDraft {
  id          String   @id @default(cuid())
  leadId      String
  stage       String
  content     String
  approved    Boolean  @default(false)
  rejected    Boolean  @default(false)
  subject     String   @default("")
  provider    String   @default("mock")
  warnings    Json?
  revision    Int      @default(1)
  revisions   DraftRevision[]
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model DraftRevision {
  id        String @id @default(cuid())
  draftId   String
  revision  Int
  subject   String
  content   String
  decision  String
  createdAt DateTime @default(now())
  draft     FollowUpDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@unique([draftId, revision])
}

enum LeadEventType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_DRAFTED
  FOLLOW_UP_APPROVED
  FOLLOW_UP_SENT
  NOTE_ADDED
  CUSTOM
}

model LeadEvent {
  id         String        @id @default(cuid())
  leadId     String
  eventType  LeadEventType @default(CUSTOM)
  payload    String?
  createdAt  DateTime      @default(now())
  lead       Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model FeedbackEntry {
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id               String   @id @default(cuid())
  leadId           String?
  rating           Int
  category         String?
  comments         String?
  channel          String   @default("in_app")
  metadata         Json?
  contactRequested Boolean  @default(false)
  createdAt        DateTime @default(now())
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model AuditLog {
  actorId String?
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id        String   @id @default(cuid())
  action    String
  entityType String
  entityId  String?
  payload   String?
  createdAt DateTime @default(now())
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  members Member[]
  invitations Invitation[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  activeOrganizationId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Organization {
  id String @id
  name String
  slug String @unique
  logo String?
  createdAt DateTime @default(now())
  metadata String?
  timezone String @default("UTC")
  members Member[]
  invitations Invitation[]
  leads Lead[]
  feedback FeedbackEntry[]
  audit AuditLog[]
}
model Member {
  id String @id
  organizationId String
  userId String
  role String @default("member")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
}
model Invitation {
  id String @id
  organizationId String
  email String
  role String?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviterId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  @@index([email])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
