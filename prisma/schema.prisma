generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  HOT
  WON
  LOST
}

model Lead {
  mailThreads MailThread[]
  normalizedEmail String?
  normalizedPhone String?
  mergedIntoId String?
  mergedAt DateTime?
  mergedInto Lead? @relation("MergedLead", fields:[mergedIntoId], references:[id], onDelete:SetNull)
  mergedFrom Lead[] @relation("MergedLead")
  @@index([workspaceId,normalizedEmail])
  @@index([workspaceId,normalizedPhone])
  version Int @default(1)
  lastContactedAt DateTime?
  lastReplyAt DateTime?
  ownerId String?
  tasks FollowUpTask[]
  interactions Interaction[]
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id            String      @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String?
  status        LeadStatus  @default(NEW)
  hotLead       Boolean     @default(false)
  unsubscribed  Boolean     @default(false)
  optOutReason  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  drafts        FollowUpDraft[]
  events        LeadEvent[]
  timelineNotes LeadNote[]
  feedbackEntries FeedbackEntry[]
}

model FollowUpDraft {
  contextSnapshot Json?
  profileVersion Int?
  id          String   @id @default(cuid())
  leadId      String
  stage       String
  content     String
  approved    Boolean  @default(false)
  rejected    Boolean  @default(false)
  subject     String   @default("")
  provider    String   @default("mock")
  warnings    Json?
  revision    Int      @default(1)
  revisions   DraftRevision[]
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model DraftRevision {
  id        String @id @default(cuid())
  draftId   String
  revision  Int
  subject   String
  content   String
  decision  String
  createdAt DateTime @default(now())
  draft     FollowUpDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@unique([draftId, revision])
}

enum LeadEventType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_DRAFTED
  FOLLOW_UP_APPROVED
  FOLLOW_UP_SENT
  NOTE_ADDED
  CUSTOM
}

model LeadEvent {
  id         String        @id @default(cuid())
  leadId     String
  eventType  LeadEventType @default(CUSTOM)
  payload    String?
  createdAt  DateTime      @default(now())
  lead       Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model FeedbackEntry {
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id               String   @id @default(cuid())
  leadId           String?
  rating           Int
  category         String?
  comments         String?
  channel          String   @default("in_app")
  metadata         Json?
  contactRequested Boolean  @default(false)
  createdAt        DateTime @default(now())
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model AuditLog {
  actorLabel String?
  actorId String?
  workspaceId String @default("legacy")
  workspace Organization @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId])
  id        String   @id @default(cuid())
  action    String
  entityType String
  entityId  String?
  payload   String?
  createdAt DateTime @default(now())
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  members Member[]
  invitations Invitation[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  activeOrganizationId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Organization {
  id String @id
  name String
  slug String @unique
  logo String?
  createdAt DateTime @default(now())
  metadata String?
  timezone String @default("UTC")
  members Member[]
  invitations Invitation[]
  leads Lead[]
  feedback FeedbackEntry[]
  audit AuditLog[]
}
model Member {
  id String @id
  organizationId String
  userId String
  role String @default("member")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
}
model Invitation {
  id String @id
  organizationId String
  email String
  role String?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviterId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  @@index([email])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}

model FollowUpTask {
  id String @id @default(cuid())
  leadId String
  title String
  dueAt DateTime
  status String @default("OPEN")
  revision Int @default(1)
  needsReview Boolean @default(false)
  assigneeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  @@index([leadId,status])
  @@index([status,dueAt])
}
model Interaction {
  actorLabel String?
  id String @id @default(cuid())
  leadId String
  channel String
  direction String
  outcome String
  occurredAt DateTime
  actorId String?
  provenance String @default("manual")
  requestKey String
  requestHash String
  note String?
  createdAt DateTime @default(now())
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  @@unique([leadId,requestKey])
  @@index([leadId,occurredAt])
}

model Notification {
  id String @id @default(cuid())
  workspaceId String
  userId String
  leadId String?
  taskId String?
  taskRevision Int?
  kind String
  title String
  dedupeKey String @unique
  createdAt DateTime @default(now())
  readAt DateTime?
  emailState String @default("DISABLED")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  leaseAt DateTime?
  sentAt DateTime?
  errorCode String?
  @@index([workspaceId,userId,createdAt])
  @@index([emailState,nextAttemptAt])
}
model NotificationPreference {
  id String @id @default(cuid())
  workspaceId String
  userId String
  emailEnabled Boolean @default(false)
  digestEnabled Boolean @default(false)
  digestHour Int @default(9)
  @@unique([workspaceId,userId])
}
model WorkerHeartbeat {
  id String @id
  seenAt DateTime @default(now())
  successAt DateTime?
  errorCode String?
}

model WritingProfile {
  workspaceId String @id
  version Int @default(1)
  tone String @default("friendly")
  signoff String @default("Best,\nSales Follow-Up Copilot")
  examples Json @default("[]")
  bannedPhrases Json @default("[]")
  updatedAt DateTime @updatedAt
}
model AiUsage {
  id String @id
  count Int @default(0)
}
model GmailConnection {
  id String @id @default(cuid())
  workspaceId String
  userId String
  email String
  refreshToken String
  accessToken String?
  expiresAt DateTime?
  state String @default("CONNECTED")
  lastSyncAt DateTime?
  nextSyncAt DateTime @default(now())
  errorCode String?
  threads MailThread[]
  @@unique([workspaceId,userId])
}
model OAuthState {
  id String @id
  workspaceId String
  userId String
  verifier String
  expiresAt DateTime
}
model MailThread {
  sharedByLabel String?
  id String @id @default(cuid())
  workspaceId String
  leadId String
  connectionId String?
  providerThreadId String
  subject String
  sharedBy String?
  createdAt DateTime @default(now())
  lastSyncAt DateTime?
  connection GmailConnection? @relation(fields:[connectionId],references:[id],onDelete:SetNull)
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  messages MailMessage[]
  @@unique([connectionId,providerThreadId,leadId])
  @@index([workspaceId,leadId])
}
model MailMessage {
  id String @id @default(cuid())
  threadId String
  providerMessageId String
  subject String
  from String
  to String
  text String
  occurredAt DateTime
  direction String
  interactionId String?
  thread MailThread @relation(fields:[threadId],references:[id],onDelete:Cascade)
  @@unique([threadId,providerMessageId])
}

model OnboardingState {
  id String @id @default(cuid())
  workspaceId String
  userId String
  dismissedAt DateTime?
  @@unique([workspaceId,userId])
}
