{
  "name": "sales-followup-copilot",
  "private": true,
  "version": "0.2.0",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "import:csv": "node scripts/import-leads-csv.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "format": "prettier --write src/app src/server e2e playwright.config.ts vitest.config.ts eslint.config.mjs scripts prisma/seed.mjs docs README.md CONTRIBUTING.md SECURITY.md",
    "account:owner": "tsx scripts/account.mts",
    "start:server": "next start --hostname 0.0.0.0",
    "setup": "node scripts/setup.mjs",
    "worker": "tsx scripts/worker.mts",
    "backup": "sh scripts/backup.sh"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.14",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "5.18.0",
    "better-auth": "^1.7.14",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg-boss": "^12.38.0",
    "prisma": "^5.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "description": "Free, self-hostable follow-up workspace for consultants and small agencies",
  "repository": {
    "type": "git",
    "url": "https://github.com/mendyraul/sales-followup-copilot.git"
  }
}
